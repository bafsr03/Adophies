{% comment %}
  Adophies — Homepage four-pillar landing grid.

  Renders up to 4 large editorial tiles, one per category:
    Women's Clothing | Hat Bar | Jewelry / Charm Bar | Baby

  Each tile has its own image, title, subtitle, and link target.
  Easily reorderable / re-labelable in the theme customizer.
{% endcomment %}

<style>
  .four-pillars-{{ section.id }} {
    padding: 64px 24px;
    background: linear-gradient(180deg, #fffaec 0%, var(--color-body) 100%);
  }
  .four-pillars-{{ section.id }} .pillars-header {
    max-width: 720px;
    margin: 0 auto 40px;
    text-align: center;
  }
  .four-pillars-{{ section.id }} .pillars-eyebrow {
    display: inline-block;
    font-size: 12px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: {{ section.settings.eyebrow_color | default: '#deb071' }};
    margin-bottom: 10px;
  }
  .four-pillars-{{ section.id }} .pillars-title {
    font-family: var(--font-stack-header);
    font-size: clamp(28px, 4vw, 44px);
    color: #544541;
    margin: 0 0 8px;
    line-height: 1.15;
  }
  .four-pillars-{{ section.id }} .pillars-subtitle {
    color: #544541;
    opacity: 0.78;
    margin: 0;
  }
  .four-pillars-{{ section.id }} .pillars-grid {
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size | at_most: 4 | at_least: 1 }}, 1fr);
    gap: 18px;
    max-width: 1280px;
    margin: 0 auto;
  }
  @media (max-width: 990px) {
    .four-pillars-{{ section.id }} .pillars-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 540px) {
    .four-pillars-{{ section.id }} .pillars-grid { grid-template-columns: 1fr; }
  }
  .four-pillars-{{ section.id }} .pillar {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: 18px;
    display: flex;
    align-items: flex-end;
    text-decoration: none;
    color: #fff;
    box-shadow: 0 8px 24px rgba(84, 69, 65, 0.10);
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }
  .four-pillars-{{ section.id }} .pillar:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 36px rgba(84, 69, 65, 0.18);
  }
  .four-pillars-{{ section.id }} .pillar__media {
    position: absolute; inset: 0;
    background-size: cover;
    background-position: center;
    transition: transform 0.6s ease;
  }
  .four-pillars-{{ section.id }} .pillar:hover .pillar__media {
    transform: scale(1.05);
  }
  .four-pillars-{{ section.id }} .pillar__media::after {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(84,69,65,0) 35%, rgba(84,69,65,0.72) 100%);
  }
  .four-pillars-{{ section.id }} .pillar__inner {
    position: relative;
    z-index: 1;
    padding: 24px 22px 26px;
    width: 100%;
  }
  .four-pillars-{{ section.id }} .pillar__title {
    font-family: var(--font-stack-header);
    font-size: clamp(20px, 2.4vw, 28px);
    letter-spacing: 0.02em;
    margin: 0 0 4px;
    color: #fff;
  }
  .four-pillars-{{ section.id }} .pillar__subtitle {
    font-size: 13px;
    opacity: 0.92;
    margin: 0 0 12px;
  }
  .four-pillars-{{ section.id }} .pillar__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #fff;
    border-bottom: 1px solid rgba(255,255,255,0.7);
    padding-bottom: 4px;
    transition: gap 0.25s ease;
  }
  .four-pillars-{{ section.id }} .pillar:hover .pillar__cta {
    gap: 14px;
  }
</style>

<section class="four-pillars-{{ section.id }}"
         data-section-id="{{ section.id }}"
         data-section-type="four-pillars">
  {%- if section.settings.eyebrow != blank or section.settings.title != blank or section.settings.subtitle != blank -%}
    <div class="pillars-header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="pillars-eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="pillars-title">{{ section.settings.title | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="pillars-subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="pillars-grid">
    {%- for block in section.blocks -%}
      {%- assign tile_link = block.settings.link | default: '#' -%}
      {%- assign img_url = block.settings.image | img_url: '1100x' -%}
      <a class="pillar" href="{{ tile_link }}" {{ block.shopify_attributes }}>
        <div class="pillar__media" style="{% if block.settings.image %}background-image: url('{{ img_url }}');{% else %}background: linear-gradient(135deg, #ffe3d6, #fff5f0);{% endif %}"></div>
        <div class="pillar__inner">
          <h3 class="pillar__title">{{ block.settings.title | escape }}</h3>
          {%- if block.settings.subtitle != blank -%}
            <p class="pillar__subtitle">{{ block.settings.subtitle | escape }}</p>
          {%- endif -%}
          <span class="pillar__cta">{{ block.settings.cta | default: 'Shop now' | escape }} →</span>
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Four pillars",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Welcome to Adophies" },
    { "type": "text", "id": "title", "label": "Title", "default": "For the girls who love pretty things" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle",
      "default": "Four worlds. One boutique. Pick your aisle." }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Background image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Women's Clothing" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Dresses, sets and everyday softness." },
        { "type": "text", "id": "cta", "label": "CTA label", "default": "Shop the aisle" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Four pillars",
      "category": "Image",
      "blocks": [
        { "type": "pillar", "settings": { "title": "Women's Clothing", "subtitle": "Dresses, sets and everyday softness.", "cta": "Shop women's" } },
        { "type": "pillar", "settings": { "title": "Hat Bar",         "subtitle": "Pressed, burned, made yours.",         "cta": "Visit the Hat Bar" } },
        { "type": "pillar", "settings": { "title": "Charm Bar",       "subtitle": "Tiny, dainty, mix-and-match.",           "cta": "Explore charms" } },
        { "type": "pillar", "settings": { "title": "Baby",            "subtitle": "Sweet things for the littlest ones.",   "cta": "Shop baby" } }
      ]
    }
  ]
}
{% endschema %}
