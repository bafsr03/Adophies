{% comment %}
  Adophies — Full-bleed 3D hero.

  Replaces the hero video with a <model-viewer> showing the storefront GLB.
  Wordmark logo sits across the top, "Step inside" CTA pinned bottom-center.

  LOCAL DEV: the GLB (~50MB) is too large for Shopify theme assets.
  Serve it from a local HTTP server and paste the URL in the section settings:
    python3 -m http.server 8000 --directory /Users/prueba/Desktop/Adophies/
  Then the default URL http://localhost:8000/storefront.glb just works.
{% endcomment %}

<link rel="stylesheet" href="{{ 'jewelry-3d.css' | asset_url }}">

<section class="hero-3d"
         data-section-id="{{ section.id }}"
         data-section-type="hero-3d"
         style="--hero-3d-bg: {{ section.settings.bg_color }};">

  {%- if section.settings.logo_image != blank -%}
    {%- assign logo_src = section.settings.logo_image | image_url: width: 1200 -%}
    {%- assign logo_alt = section.settings.logo_image.alt | default: shop.name -%}
  {%- elsif settings.logo != blank -%}
    {%- assign logo_src = settings.logo | image_url: width: 1200 -%}
    {%- assign logo_alt = settings.logo.alt | default: shop.name -%}
  {%- else -%}
    {%- assign logo_src = '' -%}
    {%- assign logo_alt = shop.name -%}
  {%- endif -%}

  {%- if logo_src != '' -%}
    <div class="hero-3d__logo" data-reveal>
      <img src="{{ logo_src }}" alt="{{ logo_alt | escape }}" loading="eager" decoding="async">
    </div>
  {%- endif -%}

  <div class="hero-3d__stage">
    {%- if section.settings.model_url != blank -%}
      {%- assign env_url = section.settings.environment_url | default: 'https://cdn.jsdelivr.net/gh/google/model-viewer@v4.0.0/packages/shared-assets/environments/aircraft_workshop_01_1k.hdr' -%}
      <model-viewer
        class="hero-3d__viewer"
        src="{{ section.settings.model_url }}"
        reveal="auto"
        loading="eager"
        interaction-prompt="none"
        disable-tap
        disable-pan
        disable-zoom
        interpolation-decay="80"
        environment-image="{{ env_url }}"
        tone-mapping="aces"
        shadow-intensity="{{ section.settings.shadow_intensity }}"
        shadow-softness="0.85"
        exposure="{{ section.settings.exposure }}"
        camera-orbit="{{ section.settings.camera_orbit_desktop }}"
        camera-target="{{ section.settings.camera_target | default: 'auto auto auto' }}"
        field-of-view="{{ section.settings.field_of_view_desktop }}deg"
        bounds="tight"
        data-orbit-desktop="{{ section.settings.camera_orbit_desktop }}"
        data-orbit-mobile="{{ section.settings.camera_orbit_mobile }}"
        data-fov-desktop="{{ section.settings.field_of_view_desktop }}"
        data-fov-mobile="{{ section.settings.field_of_view_mobile }}"
        data-zoom-factor="{{ section.settings.zoom_factor }}"
        data-mannequin-yaw="{{ section.settings.mannequin_yaw_offset }}"
        alt="Adophies storefront 3D scene">
      </model-viewer>
      <button type="button" class="hero-3d__zoom-hint" data-hero-zoom-hint aria-hidden="true">
        <span class="hero-3d__zoom-hint-icon">+</span>
        <span class="hero-3d__zoom-hint-label">Tap to zoom</span>
      </button>
    {%- else -%}
      <div class="hero-3d__placeholder">
        <p>Set the GLB URL in the section settings to render the 3D scene.</p>
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
    <a href="{{ section.settings.cta_link }}" class="hero-3d__cta" data-magnetic="0.25" data-reveal>
      {{ section.settings.cta_label | escape }}
      <span class="hero-3d__cta-arrow">→</span>
    </a>
  {%- endif -%}
</section>

<script src="{{ 'jewelry-3d.js' | asset_url }}" defer></script>

<script>
  (function () {
    var section = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!section) return;
    var v = section.querySelector('.hero-3d__viewer');
    var hint = section.querySelector('[data-hero-zoom-hint]');
    if (!v) return;

    var mq = window.matchMedia('(max-width: 749px)');
    var hoverMq = window.matchMedia('(hover: hover) and (pointer: fine)');
    var baseOrbit = v.dataset.orbitDesktop;
    var baseFov = v.dataset.fovDesktop;
    var zoomFactor = parseFloat(v.dataset.zoomFactor) || 0.55;
    var mannequinYaw = parseFloat(v.dataset.mannequinYaw) || 12;
    var parallaxYaw = 4;    // max degrees of yaw drift from mouse
    var parallaxPitch = 2.5; // max degrees of pitch drift from mouse
    var parallaxLerp = 0.08; // 0–1, lower = smoother/slower

    var isZoomed = false;
    var mannequinIndex = 0;     // next mannequin to focus (0 = left, 1 = right)
    var currentMannequin = -1;  // -1 = wide, 0 = left zoomed, 1 = right zoomed

    // Mouse parallax state (target vs eased current)
    var mouseTargetX = 0, mouseTargetY = 0;
    var mouseEasedX = 0, mouseEasedY = 0;
    var rafId = null;

    function parseOrbit(str) {
      var parts = str.trim().split(/\s+/);
      return { yaw: parts[0], pitch: parts[1], radius: parts[2] };
    }

    function getActiveOrbit() {
      // Returns the orbit object the camera should be at right now (pre-parallax)
      var o = parseOrbit(baseOrbit);
      if (!isZoomed) return { yaw: parseFloat(o.yaw) || 0, pitch: parseFloat(o.pitch) || 90, radius: o.radius };
      var yawShift = currentMannequin === 0 ? -mannequinYaw : mannequinYaw;
      var rNum = parseFloat(o.radius);
      var rUnit = o.radius.replace(/[-0-9.]/g, '') || '%';
      var closer = (rNum * zoomFactor).toFixed(1) + rUnit;
      return { yaw: (parseFloat(o.yaw) || 0) + yawShift, pitch: parseFloat(o.pitch) || 90, radius: closer };
    }

    function getActiveFov() {
      return isZoomed ? Math.max(12, parseFloat(baseFov) * 0.8) : parseFloat(baseFov);
    }

    function applyCamera() {
      var o = getActiveOrbit();
      // Parallax only when not zoomed and pointer is fine (desktop-ish)
      var px = (!isZoomed && hoverMq.matches) ? mouseEasedX * parallaxYaw : 0;
      var py = (!isZoomed && hoverMq.matches) ? mouseEasedY * parallaxPitch : 0;
      var yaw = (o.yaw + px).toFixed(2) + 'deg';
      var pitch = Math.max(20, Math.min(160, o.pitch + py)).toFixed(2) + 'deg';
      v.setAttribute('camera-orbit', yaw + ' ' + pitch + ' ' + o.radius);
      v.setAttribute('field-of-view', getActiveFov() + 'deg');
    }

    function applyBase() {
      baseOrbit = mq.matches ? v.dataset.orbitMobile : v.dataset.orbitDesktop;
      baseFov = mq.matches ? v.dataset.fovMobile : v.dataset.fovDesktop;
      applyCamera();
    }
    applyBase();
    (mq.addEventListener ? mq.addEventListener.bind(mq, 'change') : mq.addListener.bind(mq))(applyBase);

    function zoomOut() {
      isZoomed = false;
      currentMannequin = -1;
      section.classList.remove('is-zoomed');
      delete section.dataset.mannequin;
      applyCamera();
    }

    function zoomIn() {
      currentMannequin = mannequinIndex;
      isZoomed = true;
      section.classList.add('is-zoomed');
      section.dataset.mannequin = currentMannequin === 0 ? 'left' : 'right';
      mannequinIndex = 1 - mannequinIndex; // flip for next click
      applyCamera();
    }

    function toggleZoom() {
      if (isZoomed) zoomOut(); else zoomIn();
    }

    v.addEventListener('click', function (e) {
      if (e.target.closest('.hero-3d__cta')) return;
      toggleZoom();
    });
    if (hint) hint.addEventListener('click', toggleZoom);

    // ---- Mouse parallax loop (desktop only) ----
    function startRaf() {
      if (rafId) return;
      var tick = function () {
        var dx = mouseTargetX - mouseEasedX;
        var dy = mouseTargetY - mouseEasedY;
        mouseEasedX += dx * parallaxLerp;
        mouseEasedY += dy * parallaxLerp;
        applyCamera();
        if (Math.abs(dx) < 0.001 && Math.abs(dy) < 0.001) {
          mouseEasedX = mouseTargetX;
          mouseEasedY = mouseTargetY;
          rafId = null;
          return;
        }
        rafId = requestAnimationFrame(tick);
      };
      rafId = requestAnimationFrame(tick);
    }

    section.addEventListener('mousemove', function (e) {
      if (!hoverMq.matches) return;
      var rect = section.getBoundingClientRect();
      mouseTargetX = ((e.clientX - rect.left) / rect.width - 0.5) * 2;
      mouseTargetY = ((e.clientY - rect.top) / rect.height - 0.5) * 2;
      startRaf();
    });
    section.addEventListener('mouseleave', function () {
      mouseTargetX = 0;
      mouseTargetY = 0;
      startRaf();
    });

    v.addEventListener('load', function () {
      section.classList.add('is-loaded');
    });
  })();
</script>

{% schema %}
{
  "name": "Hero 3D",
  "settings": [
    { "type": "text", "id": "model_url", "label": "GLB file URL",
      "info": "Upload the .glb under Settings > Files and paste the CDN URL." },
    { "type": "image_picker", "id": "logo_image", "label": "Logo override (optional)",
      "info": "Leave empty to use the theme logo from Theme settings > Logo." },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#f6ece3" },
    { "type": "header", "content": "Call to action" },
    { "type": "text", "id": "cta_label", "label": "Button text", "default": "Step inside" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "header", "content": "3D framing — Desktop" },
    { "type": "text", "id": "camera_orbit_desktop", "label": "Camera orbit (desktop)", "default": "0deg 90deg 42%",
      "info": "Format: yaw pitch radius. Pitch 90° = eye-level. Smaller radius = closer." },
    { "type": "range", "id": "field_of_view_desktop", "label": "Field of view (desktop)", "min": 12, "max": 60, "step": 1, "default": 20, "unit": "°" },
    { "type": "header", "content": "3D framing — Mobile" },
    { "type": "text", "id": "camera_orbit_mobile", "label": "Camera orbit (mobile)", "default": "0deg 90deg 55%",
      "info": "Frames the door tightly so click-to-zoom feels dramatic." },
    { "type": "range", "id": "field_of_view_mobile", "label": "Field of view (mobile)", "min": 12, "max": 60, "step": 1, "default": 24, "unit": "°" },
    { "type": "text", "id": "camera_target", "label": "Camera target offset",
      "info": "Where the camera aims. 'auto auto auto' centers on the model. Manual format: '0m -0.5m 0m' lowers the aim point. Leave blank for auto." },
    { "type": "header", "content": "Interaction" },
    { "type": "range", "id": "zoom_factor", "label": "Click-zoom amount", "min": 0.3, "max": 0.9, "step": 0.1, "default": 0.5,
      "info": "How close the camera moves on click. 0.5 = zoom to half the distance." },
    { "type": "range", "id": "mannequin_yaw_offset", "label": "Mannequin yaw shift", "min": 0, "max": 30, "step": 1, "default": 12, "unit": "°",
      "info": "Yaw angle to shift toward left/right mannequin on alternating clicks." },
    { "type": "header", "content": "Lighting (realistic look)" },
    { "type": "text", "id": "environment_url", "label": "HDR environment URL",
      "info": "Optional. Leave blank for the default sunrise HDR. Try the Poly Haven HDRIs for different moods." },
    { "type": "range", "id": "shadow_intensity", "label": "Shadow intensity", "min": 0, "max": 1, "step": 0.1, "default": 0.6 },
    { "type": "range", "id": "exposure", "label": "Exposure", "min": 0.5, "max": 2.5, "step": 0.1, "default": 1.2 }
  ],
  "presets": [
    { "name": "Hero 3D", "category": "Image" }
  ]
}
{% endschema %}
