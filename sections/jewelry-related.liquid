{% comment %}
  Adophies — "You may also like" combo on the jewelry product page.

  Picks ONE product from each of three configured collections (earrings, rings,
  bracelets) so visitors see a curated trio that completes the set. The current
  product is filtered out so it never appears in its own related list.

  Each card uses the same `jewelry-model-card` snippet + camera config as the
  jewelry-trio page, so the look + animation are perfectly consistent.
{% endcomment %}

<link rel="stylesheet" href="{{ 'jewelry-3d.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'jewelry-product.css' | asset_url }}">

{%- assign h_earrings = section.settings.earrings_collection -%}
{%- assign h_rings = section.settings.rings_collection -%}
{%- assign h_bracelets = section.settings.bracelets_collection -%}

{%- assign col_earrings = collections[h_earrings] -%}
{%- assign col_rings = collections[h_rings] -%}
{%- assign col_bracelets = collections[h_bracelets] -%}

{%- assign pick_earring = null -%}
{%- if col_earrings != empty -%}
  {%- for p in col_earrings.products limit: 8 -%}
    {%- if p.handle != product.handle and p.available -%}
      {%- assign pick_earring = p -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- assign pick_ring = null -%}
{%- if col_rings != empty -%}
  {%- for p in col_rings.products limit: 8 -%}
    {%- if p.handle != product.handle and p.available -%}
      {%- assign pick_ring = p -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- assign pick_bracelet = null -%}
{%- if col_bracelets != empty -%}
  {%- for p in col_bracelets.products limit: 8 -%}
    {%- if p.handle != product.handle and p.available -%}
      {%- assign pick_bracelet = p -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- assign has_any = false -%}
{%- if pick_earring or pick_ring or pick_bracelet -%}
  {%- assign has_any = true -%}
{%- endif -%}

{%- if has_any -%}
  <section class="jewelry-related" data-jewelry-related>
    <header class="jewelry-related__header" data-reveal>
      <span class="jewelry-related__eyebrow">{{ section.settings.eyebrow | escape | default: 'Complete the set' }}</span>
      <h2 class="jewelry-related__title">{{ section.settings.title | default: 'You may also like' }}</h2>
    </header>

    <div class="jewelry-related__grid">

      {%- if pick_earring -%}
        {%- assign rel = pick_earring -%}
        {%- capture model_resolved -%}{{ rel.metafields.custom.model_url }}{%- endcapture -%}
        {%- assign model_resolved = model_resolved | strip -%}
        {%- if model_resolved == '' -%}
          {%- capture model_resolved -%}{{ rel.metafields.custom.custom_model_url }}{%- endcapture -%}
          {%- assign model_resolved = model_resolved | strip -%}
        {%- endif -%}
        {%- if model_resolved == '' -%}
          {%- for m in rel.media -%}
            {%- if m.media_type == 'model' -%}
              {%- for s in m.sources -%}
                {%- if s.format == 'glb' and model_resolved == '' -%}{%- assign model_resolved = s.url -%}{%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

        <div class="jewelry-related__slot jewelry-related__slot--earring">
          {%- assign card_model_url = model_resolved -%}
          {%- assign card_poster_url = rel.featured_media | img_url: '700x' -%}
          {%- assign card_name = rel.title -%}
          {%- assign card_price = rel.price | money -%}
          {%- capture card_material -%}{{ rel.metafields.custom.material }}{%- endcapture -%}
          {%- assign card_material = card_material | strip -%}
          {%- if card_material == '' -%}
            {%- capture card_material -%}{{ rel.metafields.custom.custom_material }}{%- endcapture -%}
            {%- assign card_material = card_material | strip -%}
          {%- endif -%}
          {%- capture card_dimensions -%}{{ rel.metafields.custom.dimensions }}{%- endcapture -%}
          {%- assign card_dimensions = card_dimensions | strip -%}
          {%- if card_dimensions == '' -%}
            {%- capture card_dimensions -%}{{ rel.metafields.custom.custom_dimensions }}{%- endcapture -%}
            {%- assign card_dimensions = card_dimensions | strip -%}
          {%- endif -%}
          {%- assign card_product_url = rel.url -%}
          {%- assign card_id = rel.id | append: '-rel' -%}
          {%- assign card_eager = 'false' -%}
          {%- assign card_camera_orbit = '0deg 78deg 145%' -%}
          {%- assign card_min_orbit = 'auto auto 110%' -%}
          {%- assign card_max_orbit = 'auto auto 180%' -%}
          {%- assign card_fov = '26deg' -%}
          {%- assign card_animation = 'sway' -%}
          {% include 'jewelry-model-card' %}
        </div>
      {%- endif -%}

      {%- if pick_ring -%}
        {%- assign rel = pick_ring -%}
        {%- capture model_resolved -%}{{ rel.metafields.custom.model_url }}{%- endcapture -%}
        {%- assign model_resolved = model_resolved | strip -%}
        {%- if model_resolved == '' -%}
          {%- capture model_resolved -%}{{ rel.metafields.custom.custom_model_url }}{%- endcapture -%}
          {%- assign model_resolved = model_resolved | strip -%}
        {%- endif -%}
        {%- if model_resolved == '' -%}
          {%- for m in rel.media -%}
            {%- if m.media_type == 'model' -%}
              {%- for s in m.sources -%}
                {%- if s.format == 'glb' and model_resolved == '' -%}{%- assign model_resolved = s.url -%}{%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

        <div class="jewelry-related__slot jewelry-related__slot--ring">
          {%- assign card_model_url = model_resolved -%}
          {%- assign card_poster_url = rel.featured_media | img_url: '700x' -%}
          {%- assign card_name = rel.title -%}
          {%- assign card_price = rel.price | money -%}
          {%- capture card_material -%}{{ rel.metafields.custom.material }}{%- endcapture -%}
          {%- assign card_material = card_material | strip -%}
          {%- if card_material == '' -%}
            {%- capture card_material -%}{{ rel.metafields.custom.custom_material }}{%- endcapture -%}
            {%- assign card_material = card_material | strip -%}
          {%- endif -%}
          {%- capture card_dimensions -%}{{ rel.metafields.custom.dimensions }}{%- endcapture -%}
          {%- assign card_dimensions = card_dimensions | strip -%}
          {%- if card_dimensions == '' -%}
            {%- capture card_dimensions -%}{{ rel.metafields.custom.custom_dimensions }}{%- endcapture -%}
            {%- assign card_dimensions = card_dimensions | strip -%}
          {%- endif -%}
          {%- assign card_product_url = rel.url -%}
          {%- assign card_id = rel.id | append: '-rel' -%}
          {%- assign card_eager = 'false' -%}
          {%- assign card_camera_orbit = '0deg 75deg 145%' -%}
          {%- assign card_min_orbit = 'auto auto 110%' -%}
          {%- assign card_max_orbit = 'auto auto 180%' -%}
          {%- assign card_fov = '26deg' -%}
          {%- assign card_animation = 'rotate' -%}
          {% include 'jewelry-model-card' %}
        </div>
      {%- endif -%}

      {%- if pick_bracelet -%}
        {%- assign rel = pick_bracelet -%}
        {%- capture model_resolved -%}{{ rel.metafields.custom.model_url }}{%- endcapture -%}
        {%- assign model_resolved = model_resolved | strip -%}
        {%- if model_resolved == '' -%}
          {%- capture model_resolved -%}{{ rel.metafields.custom.custom_model_url }}{%- endcapture -%}
          {%- assign model_resolved = model_resolved | strip -%}
        {%- endif -%}
        {%- if model_resolved == '' -%}
          {%- for m in rel.media -%}
            {%- if m.media_type == 'model' -%}
              {%- for s in m.sources -%}
                {%- if s.format == 'glb' and model_resolved == '' -%}{%- assign model_resolved = s.url -%}{%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

        <div class="jewelry-related__slot jewelry-related__slot--bracelet">
          {%- assign card_model_url = model_resolved -%}
          {%- assign card_poster_url = rel.featured_media | img_url: '700x' -%}
          {%- assign card_name = rel.title -%}
          {%- assign card_price = rel.price | money -%}
          {%- capture card_material -%}{{ rel.metafields.custom.material }}{%- endcapture -%}
          {%- assign card_material = card_material | strip -%}
          {%- if card_material == '' -%}
            {%- capture card_material -%}{{ rel.metafields.custom.custom_material }}{%- endcapture -%}
            {%- assign card_material = card_material | strip -%}
          {%- endif -%}
          {%- capture card_dimensions -%}{{ rel.metafields.custom.dimensions }}{%- endcapture -%}
          {%- assign card_dimensions = card_dimensions | strip -%}
          {%- if card_dimensions == '' -%}
            {%- capture card_dimensions -%}{{ rel.metafields.custom.custom_dimensions }}{%- endcapture -%}
            {%- assign card_dimensions = card_dimensions | strip -%}
          {%- endif -%}
          {%- assign card_product_url = rel.url -%}
          {%- assign card_id = rel.id | append: '-rel' -%}
          {%- assign card_eager = 'false' -%}
          {%- assign card_camera_orbit = '-28deg 60deg 105%' -%}
          {%- assign card_min_orbit = 'auto auto 85%' -%}
          {%- assign card_max_orbit = 'auto auto 160%' -%}
          {%- assign card_fov = '22deg' -%}
          {%- assign card_animation = 'rotate' -%}
          {% include 'jewelry-model-card' %}
        </div>
      {%- endif -%}

    </div>
  </section>
{%- endif -%}

<script src="{{ 'jewelry-3d.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Jewelry — related",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Complete the set" },
    { "type": "text", "id": "title", "label": "Heading", "default": "You may also like" },
    {
      "type": "header",
      "content": "Source collections"
    },
    {
      "type": "paragraph",
      "content": "Paste the collection handles (e.g. \"earrings\", \"rings\", \"bracelets\"). The section picks the first available product from each."
    },
    { "type": "text", "id": "earrings_collection", "label": "Earrings collection handle", "default": "earrings" },
    { "type": "text", "id": "rings_collection", "label": "Rings collection handle", "default": "rings" },
    { "type": "text", "id": "bracelets_collection", "label": "Bracelets collection handle", "default": "bracelets" }
  ],
  "presets": [
    { "name": "Jewelry — related", "category": "Product" }
  ]
}
{% endschema %}
