{% comment %}
  Adophies — "You may also like" combo on the jewelry product page.

  Fills up to 3 cards. Round-robins across the three configured collections
  (earrings, rings, bracelets) so visitors see a varied mix. If a category
  is empty (e.g. you only have earrings uploaded so far), the remaining slots
  are filled with more products from whatever collections do have stock.

  Each card uses the same `jewelry-model-card` snippet + camera config as
  the jewelry-trio page so the look + animation are consistent.
{% endcomment %}

<link rel="stylesheet" href="{{ 'jewelry-3d.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'jewelry-product.css' | asset_url }}">

{%- assign h_earrings = section.settings.earrings_collection -%}
{%- assign h_rings = section.settings.rings_collection -%}
{%- assign h_bracelets = section.settings.bracelets_collection -%}

{%- assign col_earrings = collections[h_earrings] -%}
{%- assign col_rings = collections[h_rings] -%}
{%- assign col_bracelets = collections[h_bracelets] -%}

{%- assign max_picks = 3 -%}
{%- assign rendered_count = 0 -%}
{%- assign rendered_handles = ',' -%}

{%- comment -%} Pre-check: do we have anything at all? {%- endcomment -%}
{%- assign has_any = false -%}
{%- if col_earrings != empty and col_earrings.products_count > 0 -%}{%- assign has_any = true -%}{%- endif -%}
{%- if col_rings != empty and col_rings.products_count > 0 -%}{%- assign has_any = true -%}{%- endif -%}
{%- if col_bracelets != empty and col_bracelets.products_count > 0 -%}{%- assign has_any = true -%}{%- endif -%}

{%- if has_any -%}
  <section class="jewelry-related" data-jewelry-related>
    <header class="jewelry-related__header">
      <span class="jewelry-related__eyebrow">{{ section.settings.eyebrow | escape | default: 'Complete the set' }}</span>
      <h2 class="jewelry-related__title">{{ section.settings.title | default: 'You may also like' }}</h2>
    </header>

    <div class="jewelry-related__grid">

      {%- comment -%}
        Round-robin: up to 3 rounds, each round tries one product from each
        collection in turn. This guarantees variety when all three are stocked,
        and falls back to filling slots from whichever collection has more
        products when others are empty.
      {%- endcomment -%}
      {%- for round in (1..3) -%}
        {%- if rendered_count >= max_picks -%}{%- break -%}{%- endif -%}

        {%- comment -%} ---- EARRING slot ---- {%- endcomment -%}
        {%- if col_earrings != empty and rendered_count < max_picks -%}
          {%- assign found = false -%}
          {%- for p in col_earrings.products limit: 30 -%}
            {%- if found -%}{%- break -%}{%- endif -%}
            {%- if p.handle != product.handle and p.available -%}
              {%- unless rendered_handles contains p.handle -%}
                {%- assign rel = p -%}
                {%- assign rel_category_label = 'earring' -%}
                {%- include 'jewelry-related-render' -%}
                {%- assign rendered_handles = rendered_handles | append: p.handle | append: ',' -%}
                {%- assign rendered_count = rendered_count | plus: 1 -%}
                {%- assign found = true -%}
              {%- endunless -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

        {%- comment -%} ---- RING slot ---- {%- endcomment -%}
        {%- if col_rings != empty and rendered_count < max_picks -%}
          {%- assign found = false -%}
          {%- for p in col_rings.products limit: 30 -%}
            {%- if found -%}{%- break -%}{%- endif -%}
            {%- if p.handle != product.handle and p.available -%}
              {%- unless rendered_handles contains p.handle -%}
                {%- assign rel = p -%}
                {%- assign rel_category_label = 'ring' -%}
                {%- include 'jewelry-related-render' -%}
                {%- assign rendered_handles = rendered_handles | append: p.handle | append: ',' -%}
                {%- assign rendered_count = rendered_count | plus: 1 -%}
                {%- assign found = true -%}
              {%- endunless -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

        {%- comment -%} ---- BRACELET slot ---- {%- endcomment -%}
        {%- if col_bracelets != empty and rendered_count < max_picks -%}
          {%- assign found = false -%}
          {%- for p in col_bracelets.products limit: 30 -%}
            {%- if found -%}{%- break -%}{%- endif -%}
            {%- if p.handle != product.handle and p.available -%}
              {%- unless rendered_handles contains p.handle -%}
                {%- assign rel = p -%}
                {%- assign rel_category_label = 'bracelet' -%}
                {%- include 'jewelry-related-render' -%}
                {%- assign rendered_handles = rendered_handles | append: p.handle | append: ',' -%}
                {%- assign rendered_count = rendered_count | plus: 1 -%}
                {%- assign found = true -%}
              {%- endunless -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

      {%- endfor -%}

    </div>
  </section>
{%- endif -%}

<script src="{{ 'jewelry-3d.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Jewelry — related",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Complete the set" },
    { "type": "text", "id": "title", "label": "Heading", "default": "You may also like" },
    {
      "type": "header",
      "content": "Source collections"
    },
    {
      "type": "paragraph",
      "content": "Paste the collection handles (e.g. \"earrings\", \"rings\", \"bracelets\"). The section round-robins through them, filling up to 3 cards. Empty categories are skipped — remaining slots are filled from whichever collections have more products."
    },
    { "type": "text", "id": "earrings_collection", "label": "Earrings collection handle", "default": "earrings" },
    { "type": "text", "id": "rings_collection", "label": "Rings collection handle", "default": "rings" },
    { "type": "text", "id": "bracelets_collection", "label": "Bracelets collection handle", "default": "bracelets" }
  ],
  "presets": [
    { "name": "Jewelry — related", "category": "Product" }
  ]
}
{% endschema %}
