{% comment %}
  Adophies — Homepage 3D jewelry teaser.

  Shows up to 3 featured pieces with auto-rotating <model-viewer>
  cards. A "View the full Charm Bar" CTA links to the dedicated
  /pages/charm-bar page that holds the full 15-piece gallery.

  Loading budget: ~10 MB total (eager-loaded, 3 compressed GLBs).
  Below-the-fold by default so it doesn't block hero.
{% endcomment %}

<link rel="stylesheet" href="{{ 'jewelry-3d.css' | asset_url }}">

<section class="jewelry-3d-section jewelry-3d-section--teaser"
         data-section-id="{{ section.id }}"
         data-section-type="jewelry-3d-teaser">
  <div class="jewelry-3d-section__header">
    {%- if section.settings.eyebrow != blank -%}
      <span class="jewelry-3d-section__eyebrow">{{ section.settings.eyebrow | escape }}</span>
    {%- endif -%}
    {%- if section.settings.title != blank -%}
      <h2 class="jewelry-3d-section__title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.subtitle != blank -%}
      <p class="jewelry-3d-section__subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}
  </div>

  <div class="jewelry-grid jewelry-grid--teaser">
    {%- for block in section.blocks -%}
      {%- assign card_model_url = block.settings.model_url -%}
      {%- assign card_poster_url = block.settings.poster | img_url: '600x' -%}
      {%- if block.settings.poster == blank and block.settings.poster_url != blank -%}
        {%- assign card_poster_url = block.settings.poster_url -%}
      {%- endif -%}
      {%- assign card_name = block.settings.name -%}
      {%- assign card_price = block.settings.price -%}
      {%- assign card_material = block.settings.material -%}
      {%- assign card_dimensions = block.settings.dimensions -%}
      {%- assign card_product_url = block.settings.product_url -%}
      {%- assign card_id = block.id -%}
      {%- assign card_eager = 'true' -%}
      {% include 'jewelry-model-card' %}
    {%- endfor -%}
  </div>

  {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
    <div class="jewelry-3d-section__cta">
      <a href="{{ section.settings.cta_link }}">{{ section.settings.cta_label | escape }}</a>
    </div>
  {%- endif -%}
</section>

<script src="{{ 'jewelry-3d.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Jewelry 3D teaser",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "The Charm Bar" },
    { "type": "text", "id": "title", "label": "Title", "default": "Pieces that move with you" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle",
      "default": "Hover, spin, and explore. Each piece is hand-curated for the girls who love pretty things." },
    { "type": "header", "content": "Call to action" },
    { "type": "text", "id": "cta_label", "label": "Button text", "default": "View the full Charm Bar" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "model",
      "name": "3D model",
      "limit": 6,
      "settings": [
        { "type": "url", "id": "model_url", "label": "GLB file URL (paste from Shopify Files)",
          "info": "Upload the compressed .glb to Settings > Files, then paste the CDN URL here." },
        { "type": "image_picker", "id": "poster", "label": "Poster image",
          "info": "2D fallback shown before the 3D model loads. ~600x600px recommended." },
        { "type": "url", "id": "poster_url", "label": "Poster URL (alternative)",
          "info": "Only used if Poster image is not set. Paste a Shopify Files URL." },
        { "type": "text", "id": "name", "label": "Name", "default": "Charm name" },
        { "type": "text", "id": "price", "label": "Price", "default": "$48" },
        { "type": "text", "id": "material", "label": "Material", "default": "14k Gold-filled" },
        { "type": "text", "id": "dimensions", "label": "Dimensions", "default": "18mm x 24mm" },
        { "type": "url", "id": "product_url", "label": "Product page link" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Jewelry 3D teaser",
      "category": "Featured",
      "blocks": [
        { "type": "model" },
        { "type": "model" },
        { "type": "model" }
      ]
    }
  ]
}
{% endschema %}
