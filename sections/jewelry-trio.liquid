{% comment %}
  Adophies — Jewelry trio section.

  Renders THREE category sub-sections on /pages/jewelry:
    1. Earrings   (block type "earring")
    2. Rings      (block type "ring")
    3. Bracelets  (block type "bracelet")

  Each sub-section has its own editorial intro + grid styling.
  Models auto-load when scrolled into view (reveal="auto" + loading="lazy")
  so visitors see them without clicking.
{% endcomment %}

<link rel="stylesheet" href="{{ 'jewelry-3d.css' | asset_url }}">

{%- assign earrings  = section.blocks | where: 'type', 'earring' -%}
{%- assign rings     = section.blocks | where: 'type', 'ring' -%}
{%- assign bracelets = section.blocks | where: 'type', 'bracelet' -%}

<section class="charm-trio" data-section-id="{{ section.id }}" data-section-type="jewelry-trio">

  <!-- ============ HEADER ============ -->
  {%- assign has_hero_image = false -%}
  {%- if section.settings.hero_image != blank -%}{%- assign has_hero_image = true -%}{%- endif -%}
  <header class="charm-trio__hero{% if has_hero_image %} charm-trio__hero--split{% endif %}" data-reveal>
    {%- if has_hero_image -%}
      <div class="charm-trio__hero-media">
        <img src="{{ section.settings.hero_image | img_url: '1200x' }}"
             alt="{{ section.settings.hero_title | strip_html | escape }}"
             loading="lazy">
      </div>
    {%- endif -%}
    <div class="charm-trio__hero-text">
      <span class="charm-trio__hero-eyebrow">{{ section.settings.hero_eyebrow | escape | default: 'Adophies / Jewelry' }}</span>
      <h1 class="charm-trio__hero-title">{{ section.settings.hero_title | default: 'Jewelry, made to be worn.' }}</h1>
      <p class="charm-trio__hero-sub">{{ section.settings.hero_sub | default: 'Hand-picked metal and stones, photographed up close so you can see every detail.' }}</p>
      <div class="charm-trio__nav" aria-label="Jump to category">
        <a href="#cat-earrings">Earrings</a>
        <a href="#cat-rings">Rings</a>
        <a href="#cat-bracelets">Bracelets</a>
      </div>
    </div>
  </header>

  <!-- ============ EARRINGS ============ -->
  {%- if earrings.size > 0 -%}
    <article class="charm-cat charm-cat--earrings" id="cat-earrings">
      <div class="charm-cat__intro" data-reveal>
        <span class="charm-cat__roman">I.</span>
        <div>
          <span class="charm-cat__eyebrow">For the ears</span>
          <h2 class="charm-cat__title">Earrings.</h2>
          <p class="charm-cat__body">Everyday pairs and statement drops, photographed up close so you can find the ones that feel like you.</p>
        </div>
      </div>
      <div class="charm-cat__grid charm-cat__grid--earrings">
        {%- for block in earrings -%}
          {%- assign card_source_product = block.settings.product -%}
          {%- assign card_source_product_url = block.settings.product_url -%}
          {%- assign card_id = block.id -%}
          {% include 'jewelry-product-card' %}
        {%- endfor -%}
      </div>
    </article>
  {%- endif -%}

  <!-- ============ RINGS ============ -->
  {%- if rings.size > 0 -%}
    <article class="charm-cat charm-cat--rings" id="cat-rings">
      <div class="charm-cat__intro charm-cat__intro--center" data-reveal>
        <span class="charm-cat__roman">II.</span>
        <span class="charm-cat__eyebrow">For the hands</span>
        <h2 class="charm-cat__title">Rings.</h2>
        <p class="charm-cat__body">Solo, stacked, or stacked-up-the-knuckle. Every ring is built for a different kind of day.</p>
      </div>
      <div class="charm-cat__grid charm-cat__grid--rings">
        {%- for block in rings -%}
          {%- assign card_source_product = block.settings.product -%}
          {%- assign card_source_product_url = block.settings.product_url -%}
          {%- assign card_id = block.id -%}
          {% include 'jewelry-product-card' %}
        {%- endfor -%}
      </div>
    </article>
  {%- endif -%}

  <!-- ============ BRACELETS ============ -->
  {%- if bracelets.size > 0 -%}
    <article class="charm-cat charm-cat--bracelets" id="cat-bracelets">
      <div class="charm-cat__intro charm-cat__intro--right" data-reveal>
        <div>
          <span class="charm-cat__eyebrow">For the wrists</span>
          <h2 class="charm-cat__title">Bracelets.</h2>
          <p class="charm-cat__body">The slowest piece of jewelry to put on, the longest one to look at on your own wrist.</p>
        </div>
        <span class="charm-cat__roman">III.</span>
      </div>
      <div class="charm-cat__grid charm-cat__grid--bracelets">
        {%- for block in bracelets -%}
          {%- assign card_source_product = block.settings.product -%}
          {%- assign card_source_product_url = block.settings.product_url -%}
          {%- assign card_id = block.id -%}
          {% include 'jewelry-product-card' %}
        {%- endfor -%}
      </div>
    </article>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Jewelry trio",
  "settings": [
    { "type": "image_picker", "id": "hero_image", "label": "Hero image",
      "info": "Large lifestyle/editorial photo shown at the top, next to the intro text. Upload your own here." },
    { "type": "text", "id": "hero_eyebrow", "label": "Hero eyebrow", "default": "Adophies / Jewelry" },
    { "type": "richtext", "id": "hero_title", "label": "Hero title (HTML)",
      "default": "<p>Jewelry, made to be worn.</p>" },
    { "type": "textarea", "id": "hero_sub", "label": "Hero subtitle",
      "default": "Hand-picked metal and stones, photographed up close so you can see every detail." }
  ],
  "blocks": [
    {
      "type": "earring",
      "name": "Earring",
      "settings": [
        { "type": "product", "id": "product", "label": "Product",
          "info": "Pick the earring product. Its name, price and photo come from the product itself — edit those in Shopify Admin → Products and the card + product page both update." }
      ]
    },
    {
      "type": "ring",
      "name": "Ring",
      "settings": [
        { "type": "product", "id": "product", "label": "Product",
          "info": "Pick the ring product. Its name, price and photo come from the product itself — edit those in Shopify Admin → Products and the card + product page both update." }
      ]
    },
    {
      "type": "bracelet",
      "name": "Bracelet",
      "settings": [
        { "type": "product", "id": "product", "label": "Product",
          "info": "Pick the bracelet product. Its name, price and photo come from the product itself — edit those in Shopify Admin → Products and the card + product page both update." }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    { "name": "Jewelry trio", "category": "Custom" }
  ]
}
{% endschema %}
