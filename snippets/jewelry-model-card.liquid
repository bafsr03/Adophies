{% comment %}
  Adophies — reusable jewelry product card.

  Used by the homepage teaser, the /pages/jewelry trio, the gallery, and the
  "you may also like" related grid. Renders a single uploaded product photo
  with a hover spec overlay (Material / Size) and a name / price / "Shop now"
  meta block. Clicking the card navigates to the product page.

  Required variables (set with {% assign %} before {% include %}):
    card_poster_url      product photo URL (from the block's "Product image")
    card_name            display name
    card_id              unique id (use block.id or forloop.index)

  Optional:
    card_price           e.g. "$48"
    card_material        e.g. "14k Gold-filled"
    card_dimensions      e.g. "18mm x 24mm"
    card_product_url     PDP link (makes the whole card clickable + shows badge)
{% endcomment %}

{%- assign has_pdp_link = false -%}
{%- if card_product_url != blank -%}
  {%- assign has_pdp_link = true -%}
{%- endif -%}

<article class="jewelry-card{% if has_pdp_link %} jewelry-card--linked{% endif %}"
         data-jewelry-card
         data-card-id="{{ card_id }}"
         data-name="{{ card_name | escape }}"
         data-material="{{ card_material | escape }}"
         data-dimensions="{{ card_dimensions | escape }}"
         data-price="{{ card_price | escape }}">

  {%- comment -%}
    Media is a real <a> when a product link exists, so the whole photo is
    clickable natively — no JavaScript needed.
  {%- endcomment -%}
  {%- if has_pdp_link -%}
    <a href="{{ card_product_url }}"
       class="jewelry-card__media jewelry-card__media--linked"
       aria-label="View {{ card_name | escape }} product page">
  {%- else -%}
    <div class="jewelry-card__media">
  {%- endif -%}

    {%- if card_poster_url != blank -%}
      <img class="jewelry-card__fallback-img"
           src="{{ card_poster_url }}"
           alt="{{ card_name | escape }}"
           loading="lazy">
    {%- else -%}
      <div class="jewelry-card__placeholder">
        <span>Photo coming soon</span>
      </div>
    {%- endif -%}

    {%- if has_pdp_link -%}
      <span class="jewelry-card__view-badge" aria-hidden="true">View product →</span>
    {%- endif -%}

    {%- if card_material != blank or card_dimensions != blank -%}
      <div class="jewelry-card__hover-stats" aria-hidden="true">
        {%- if card_material != blank -%}
          <div class="jewelry-card__stat">
            <span class="jewelry-card__stat-label">Material</span>
            <span class="jewelry-card__stat-value">{{ card_material | escape }}</span>
          </div>
        {%- endif -%}
        {%- if card_dimensions != blank -%}
          <div class="jewelry-card__stat">
            <span class="jewelry-card__stat-label">Size</span>
            <span class="jewelry-card__stat-value">{{ card_dimensions | escape }}</span>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- if has_pdp_link -%}</a>{%- else -%}</div>{%- endif -%}

  <div class="jewelry-card__meta">
    <h3 class="jewelry-card__name">{{ card_name | escape }}</h3>
    {%- if card_price != blank -%}
      <div class="jewelry-card__price">{{ card_price | escape }}</div>
    {%- endif -%}
    {%- if card_product_url != blank -%}
      <a href="{{ card_product_url }}" class="jewelry-card__btn">
        Shop now →
      </a>
    {%- endif -%}
  </div>
</article>
