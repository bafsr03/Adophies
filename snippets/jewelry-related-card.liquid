{% comment %}
  Adophies — single card for the "You may also like" combo.

  Required render args:
    rel        — the product object
    rel_label  — category label (Earring / Ring / Bracelet)
{% endcomment %}

{%- comment -%} Resolve the related product's 3D model URL. {%- endcomment -%}
{%- capture rel_model_url -%}{{ rel.metafields.custom.model_url }}{%- endcapture -%}
{%- assign rel_model_url = rel_model_url | strip -%}

{%- if rel_model_url == '' -%}
  {%- capture rel_model_url -%}{{ rel.metafields.custom.custom_model_url }}{%- endcapture -%}
  {%- assign rel_model_url = rel_model_url | strip -%}
{%- endif -%}

{%- if rel_model_url == '' -%}
  {%- for m in rel.media -%}
    {%- if m.media_type == 'model' -%}
      {%- for s in m.sources -%}
        {%- if s.format == 'glb' and rel_model_url == '' -%}
          {%- assign rel_model_url = s.url -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

<a href="{{ rel.url }}" class="jewelry-related__card{% if rel_model_url != '' %} jewelry-related__card--3d{% endif %}" data-reveal>
  <div class="jewelry-related__media">
    {%- if rel_model_url != '' -%}
      <model-viewer
        class="jewelry-related__viewer"
        src="{{ rel_model_url }}"
        {% if rel.featured_media %}poster="{{ rel.featured_media | img_url: '600x' }}"{% endif %}
        reveal="auto"
        loading="lazy"
        auto-rotate
        auto-rotate-delay="600"
        rotation-per-second="14deg"
        interaction-prompt="none"
        environment-image="https://cdn.jsdelivr.net/gh/google/model-viewer@v4.0.0/packages/shared-assets/environments/aircraft_workshop_01_1k.hdr"
        tone-mapping="agx"
        shadow-intensity="0.25"
        shadow-softness="1.3"
        exposure="1.7"
        camera-orbit="0deg 75deg 150%"
        field-of-view="26deg"
        touch-action="pan-y"
        disable-tap
        disable-pan
        disable-zoom
        alt="3D model of {{ rel.title | escape }}">
        {%- if rel.featured_media -%}
          <img slot="poster" src="{{ rel.featured_media | img_url: '600x' }}" alt="{{ rel.title | escape }}" loading="lazy">
        {%- endif -%}
      </model-viewer>
    {%- elsif rel.featured_media -%}
      <img src="{{ rel.featured_media | img_url: '700x' }}"
           alt="{{ rel.title | escape }}"
           loading="lazy">
    {%- else -%}
      <div class="jewelry-related__placeholder">
        <span>{{ rel_label }}</span>
      </div>
    {%- endif -%}
    <span class="jewelry-related__chip">{{ rel_label }}</span>
  </div>
  <div class="jewelry-related__meta">
    <h3 class="jewelry-related__name">{{ rel.title }}</h3>
    <div class="jewelry-related__price">
      <span>{{ rel.price | money }}</span>
      {%- if rel.compare_at_price > rel.price -%}
        <span class="jewelry-related__compare">{{ rel.compare_at_price | money }}</span>
      {%- endif -%}
    </div>
    <span class="jewelry-related__arrow" aria-hidden="true">View →</span>
  </div>
</a>
