{% comment %}
  Adophies — renders one card in the "You may also like" grid.

  Delegates to jewelry-product-card so the related card resolves name / price /
  image / specs from the product exactly like the /pages/jewelry cards.

  Required args (set via {% assign %} before including):
    rel                   — the product object
    rel_category_label    — 'earring' | 'ring' | 'bracelet'
{% endcomment %}

{%- if rel_category_label == 'bracelet' -%}
  {%- assign slot_modifier = 'bracelet' -%}
{%- elsif rel_category_label == 'ring' -%}
  {%- assign slot_modifier = 'ring' -%}
{%- else -%}
  {%- assign slot_modifier = 'earring' -%}
{%- endif -%}

{%- assign card_source_product = rel -%}
{%- assign card_source_product_url = '' -%}
{%- assign card_id = rel.id | append: '-rel' -%}

<div class="jewelry-related__slot jewelry-related__slot--{{ slot_modifier }}">
  {% include 'jewelry-product-card' %}
</div>
