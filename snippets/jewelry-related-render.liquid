{% comment %}
  Adophies — renders one card in the "You may also like" grid.

  Uses the related product's featured image + specs and includes the shared
  jewelry-model-card snippet.

  Required args (set via {% assign %} before including):
    rel                   — the product object
    rel_category_label    — 'earring' | 'ring' | 'bracelet'
{% endcomment %}

{%- capture card_material -%}{{ rel.metafields.custom.material }}{%- endcapture -%}
{%- assign card_material = card_material | strip -%}
{%- if card_material == '' -%}
  {%- capture card_material -%}{{ rel.metafields.custom.custom_material }}{%- endcapture -%}
  {%- assign card_material = card_material | strip -%}
{%- endif -%}

{%- capture card_dimensions -%}{{ rel.metafields.custom.dimensions }}{%- endcapture -%}
{%- assign card_dimensions = card_dimensions | strip -%}
{%- if card_dimensions == '' -%}
  {%- capture card_dimensions -%}{{ rel.metafields.custom.custom_dimensions }}{%- endcapture -%}
  {%- assign card_dimensions = card_dimensions | strip -%}
{%- endif -%}

{%- assign card_poster_url = '' -%}
{%- if rel.featured_media != blank -%}
  {%- assign card_poster_url = rel.featured_media | img_url: '900x' -%}
{%- endif -%}
{%- assign card_name = rel.title -%}
{%- assign card_price = rel.price | money -%}
{%- assign card_product_url = rel.url -%}
{%- assign card_id = rel.id | append: '-rel' -%}

{%- if rel_category_label == 'bracelet' -%}
  {%- assign slot_modifier = 'bracelet' -%}
{%- elsif rel_category_label == 'ring' -%}
  {%- assign slot_modifier = 'ring' -%}
{%- else -%}
  {%- assign slot_modifier = 'earring' -%}
{%- endif -%}

<div class="jewelry-related__slot jewelry-related__slot--{{ slot_modifier }}">
  {% include 'jewelry-model-card' %}
</div>
