{% comment %}
  Custom page template for /pages/charm-bar.
  Uses the dedicated charm-bar-trio section that splits into
  Earrings / Rings / Bracelets sub-sections.
{% endcomment %}

<div class="page-charm-bar">
  {% section 'charm-bar-trio' %}

  {%- if page.content != blank -%}
    <div class="page-width text-center" style="padding: 40px 24px 80px;">
      <div class="rte">{{ page.content }}</div>
    </div>
  {%- endif -%}
</div>
