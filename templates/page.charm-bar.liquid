{% comment %}
  Adophies — Charm Bar page.

  Renders the interactive Charm Bar Builder (Base → Charms → Arrange → Preview).
  The builder itself lives in sections/charm-bar-builder.liquid and is
  self-showing: until the charm/base collections exist and have products it
  displays a friendly empty-state, so this page is always safe to publish.
  See CHARM-BAR-GUIDE.md for the one-time Shopify Admin setup.
{% endcomment %}

{% section 'charm-bar-builder' %}

{%- if page.content != blank -%}
  <div class="page-width text-center" style="padding: 20px 24px 80px;">
    <div class="rte">{{ page.content }}</div>
  </div>
{%- endif -%}
